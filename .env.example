# Client-safe Supabase settings. Do not put server secrets in this file.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# The server API has its own private environment file: server/.env.
# Copy server/.env.example to server/.env and set SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY there. Never prefix the service key with NEXT_PUBLIC_ or VITE_.
