# Supabase project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Server-only Supabase secret. Get it from Supabase Project Settings > API Keys.
# Never use the service-role key in NEXT_PUBLIC_* or VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"

# Run supabase/schema.sql in the Supabase SQL Editor before starting the app.
# To grant yourself admin access, sign up, then run the commented UPDATE at the end of schema.sql.
# The schema creates the public-read/private-write image bucket used for restaurant uploads.
# Run `npm run dev` and `npm run dev:api` in separate terminals for local development.

# Browser-facing origin. On Vercel, set this to your production site origin
# (for example https://menu.example.com). Vercel preview URLs are allowed automatically.
APP_ORIGIN="http://localhost:3000"
API_PORT="4000"
