# Supabase project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Server-only Supabase secret. Get it from Supabase Project Settings > API Keys.
# Never use the service-role key in NEXT_PUBLIC_* or VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"

# Run supabase/schema.sql in the Supabase SQL Editor before starting the app.
# Run `npm run dev` and `npm run dev:api` in separate terminals for local development.

# Must be the browser-facing origin. Set this to your production app origin in deployment.
APP_ORIGIN="http://localhost:3000"
API_PORT="4000"
