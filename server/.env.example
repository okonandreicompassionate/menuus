# Server-only Supabase configuration. Copy this file to server/.env locally.
# In Render, set the same values in the service's Environment settings instead.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"

# Optional for local API development. Render supplies PORT automatically.
API_PORT="4000"

# Optional canonical production origin; Render's service URL is allowed automatically.
APP_ORIGIN=""
