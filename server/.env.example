# Server-only Supabase configuration. Copy this file to server/.env locally.
# In Render, set the same values in the service's Environment settings instead.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"

# Optional for local API development. Render supplies PORT automatically.
API_PORT="4000"

# Comma-separated frontend origins allowed to call the API.
# Include the Vercel production URL and your custom frontend domain.
APP_ORIGINS="http://localhost:3000"

# Optional single-origin alternative/addition.
APP_ORIGIN=""

# Render serves the API only; Vercel serves the frontend.
API_ONLY="true"
